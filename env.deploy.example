#########################################################
# Пример .env для деплоя на Deploy-F (production)
#########################################################

# Режим
NODE_ENV="production"
PORT=3000

#########################################################
# База данных
#
# Вариант 1 — SQLite (минимальный вариант для начала).
# Файл базы будет создан командой `npx prisma db push`.
#########################################################

DATABASE_URL="file:./prisma/prod.db"

#########################################################
# NextAuth (если используете авторизацию)
#########################################################

# URL вашего приложения на Deploy-F
NEXTAUTH_URL="https://your-app.deploy-f.com"

# Секрет (сгенерируйте командой `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

#########################################################
# Python сервис (опционально)
# Если отдельный Python‑сервис не деплоится, можно оставить
# localhost или вообще не указывать эту переменную.
#########################################################

PYTHON_SERVICE_URL="http://localhost:8000"

#########################################################
# Загрузка файлов
#########################################################

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

#########################################################
# AI‑провайдеры (по желанию)
#########################################################

ZAI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

