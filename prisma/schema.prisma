// Prisma Schema для Ozon Analyzer
// PostgreSQL для production (Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь (для NextAuth)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  
  // Связи
  accounts      Account[]
  sessions      Session[]
  reports       Report[]
  costData      CostData[]
  subscription  Subscription?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// NextAuth Account
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Отчёт анализа
model Report {
  id              String   @id @default(cuid())
  userId          String?  // Опционально для MVP (анонимные пользователи)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Информация о файле
  fileName        String
  fileSize        Int
  filePath        String
  
  // Параметры анализа
  customPrompt    String?
  
  // Статус обработки
  status          String   @default("pending") // pending, processing, completed, failed
  progress        Int      @default(0)
  currentStep     String?
  errorMessage    String?
  
  // Результаты анализа (JSON)
  analysisResults String?  // JSON строка с полным результатом
  aiInsights      String?  // JSON строка с AI рекомендациями
  
  // Метаданные
  periodStart     DateTime?
  periodEnd       DateTime?
  totalOrders     Int?
  totalRevenue    Float?
  netProfit       Float?
  
  // Настройки (для будущего)
  settings        String?  // JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Данные о себестоимости товаров (для будущего функционала)
model CostData {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  sku       String
  name      String?
  cost      Float
  currency  String   @default("RUB")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, sku])
  @@index([userId])
  @@index([sku])
}

// Подписка пользователя (заготовка)
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Тарифный план
  plan              String   @default("free") // free, basic, pro
  status            String   @default("active") // active, cancelled, expired
  
  // Лимиты
  reportsUsed       Int      @default(0)
  reportsLimit      Int      @default(3)
  
  // Платёжные данные (для Stripe)
  stripeCustomerId  String?
  stripeSubscriptionId String?
  stripePriceId     String?
  
  // Период подписки
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Логи использования AI (для аналитики)
model AIUsageLog {
  id          String   @id @default(cuid())
  reportId    String?
  userId      String?
  
  provider    String   // openai, anthropic, etc
  model       String
  
  promptTokens    Int
  completionTokens Int
  totalTokens     Int
  
  latencyMs   Int
  success     Boolean
  errorMessage String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// Тарифы перевозки для калькулятора
model ShippingTariff {
  id              String   @id @default(cuid())
  
  // Маркетплейс
  marketplace     String   @default("ozon") // ozon, wildberries, yandex-market
  
  // Регионы
  fromRegion      String?  // Регион отправления
  toRegion        String?  // Регион назначения
  fromCity        String?  // Город отправления
  toCity          String?  // Город назначения
  
  // Тип доставки
  deliveryType    String?  // standard, express, economy, etc
  deliveryMethod  String?  // fbo, fbs, etc
  
  // Весовые параметры (в граммах)
  weightMin       Float?   // Минимальный вес (г)
  weightMax       Float?   // Максимальный вес (г)
  weightStep      Float?   // Шаг веса (для расчёта)
  
  // Габариты (в мм)
  lengthMin       Float?   // Минимальная длина
  lengthMax       Float?   // Максимальная длина
  widthMin        Float?   // Минимальная ширина
  widthMax        Float?   // Максимальная ширина
  heightMin       Float?   // Минимальная высота
  heightMax       Float?   // Максимальная высота
  volumeMin       Float?   // Минимальный объём (см³)
  volumeMax       Float?   // Максимальный объём (см³)
  
  // Стоимость
  basePrice       Float    // Базовая стоимость (руб)
  pricePerKg      Float?   // Стоимость за кг (руб/кг)
  pricePerVolume  Float?   // Стоимость за объём (руб/см³)
  pricePerKm      Float?   // Стоимость за км (руб/км)
  minPrice        Float?   // Минимальная стоимость
  maxPrice        Float?   // Максимальная стоимость
  
  // Дополнительные параметры
  category        String?  // Категория товара
  isActive        Boolean  @default(true) // Активен ли тариф
  priority        Int      @default(0) // Приоритет (если несколько тарифов подходят)
  notes           String?  // Примечания
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Индексы для быстрого поиска
  @@index([marketplace, fromRegion, toRegion])
  @@index([marketplace, deliveryType])
  @@index([weightMin, weightMax])
  @@index([isActive])
  @@index([priority])
}

// Таблица категорий и комиссий маркетплейса (вознаграждение маркетплейса)
model CategoryCommission {
  id           String   @id @default(cuid())

  // Маркетплейс
  marketplace  String   @default("ozon") // ozon, wildberries, yandex-market

  // Категория
  categoryId   String?  // Внутренний код категории, если есть
  categoryName String   // Отображаемое имя категории
  categoryPath String?  // Полный путь категории (например, "Электроника / Смартфоны")
  productType  String?  // Тип товара / подкатегория (из файла Ozon)

  // Тип размещения / работы
  fulfillment  String   // fbo, fbs, rfbs, express и т.п.

  // Диапазон цены (если ставки зависят от цены товара)
  priceMin     Float?
  priceMax     Float?
  tierLabel    String?  // Исходный заголовок колонки (например, "FBO до 100 руб.")

  // Ставки вознаграждения
  commissionPercent   Float    // Ставка комиссии в %, например 15.5
  minCommissionAmount Float?   // Минимальная сумма комиссии (руб), если есть
  fixedFeeAmount      Float?   // Фиксированная часть комиссии (руб), если есть

  isActive    Boolean  @default(true)
  validFrom   DateTime?
  validTo     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Индексы для быстрого поиска
  @@index([marketplace, categoryName, fulfillment])
  @@index([marketplace, categoryId, fulfillment])
  @@index([marketplace, categoryPath, fulfillment])
  @@index([marketplace, fulfillment, priceMin, priceMax])
}