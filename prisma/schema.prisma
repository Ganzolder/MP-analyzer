// Prisma Schema для Ozon Analyzer
// PostgreSQL для production (Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь (для NextAuth)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  
  // Связи
  accounts      Account[]
  sessions      Session[]
  reports       Report[]
  costData      CostData[]
  subscription  Subscription?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// NextAuth Account
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Отчёт анализа
model Report {
  id              String   @id @default(cuid())
  userId          String?  // Опционально для MVP (анонимные пользователи)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Информация о файле
  fileName        String
  fileSize        Int
  filePath        String
  
  // Параметры анализа
  customPrompt    String?
  
  // Статус обработки
  status          String   @default("pending") // pending, processing, completed, failed
  progress        Int      @default(0)
  currentStep     String?
  errorMessage    String?
  
  // Результаты анализа (JSON)
  analysisResults String?  // JSON строка с полным результатом
  aiInsights      String?  // JSON строка с AI рекомендациями
  
  // Метаданные
  periodStart     DateTime?
  periodEnd       DateTime?
  totalOrders     Int?
  totalRevenue    Float?
  netProfit       Float?
  
  // Настройки (для будущего)
  settings        String?  // JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Данные о себестоимости товаров (для будущего функционала)
model CostData {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  sku       String
  name      String?
  cost      Float
  currency  String   @default("RUB")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, sku])
  @@index([userId])
  @@index([sku])
}

// Подписка пользователя (заготовка)
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Тарифный план
  plan              String   @default("free") // free, basic, pro
  status            String   @default("active") // active, cancelled, expired
  
  // Лимиты
  reportsUsed       Int      @default(0)
  reportsLimit      Int      @default(3)
  
  // Платёжные данные (для Stripe)
  stripeCustomerId  String?
  stripeSubscriptionId String?
  stripePriceId     String?
  
  // Период подписки
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Логи использования AI (для аналитики)
model AIUsageLog {
  id          String   @id @default(cuid())
  reportId    String?
  userId      String?
  
  provider    String   // openai, anthropic, etc
  model       String
  
  promptTokens    Int
  completionTokens Int
  totalTokens     Int
  
  latencyMs   Int
  success     Boolean
  errorMessage String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// Тарифы перевозки для калькулятора
model ShippingTariff {
  id              String   @id @default(cuid())
  
  // Маркетплейс
  marketplace     String   @default("ozon") // ozon, wildberries, yandex-market

  // Сегмент тарифа (чтобы не перетирать "до 300" и "от 301" при загрузке)
  // Примеры: "up_to_300", "over_300"
  priceBand       String?
  
  // Регионы
  fromRegion      String?  // Регион отправления
  toRegion        String?  // Регион назначения
  fromCity        String?  // Город отправления
  toCity          String?  // Город назначения
  
  // Тип доставки
  deliveryType    String?  // standard, express, economy, etc
  deliveryMethod  String?  // fbo, fbs, etc
  
  // Весовые параметры (в граммах)
  weightMin       Float?   // Минимальный вес (г)
  weightMax       Float?   // Максимальный вес (г)
  weightStep      Float?   // Шаг веса (для расчёта)
  
  // Габариты (в мм)
  lengthMin       Float?   // Минимальная длина
  lengthMax       Float?   // Максимальная длина
  widthMin        Float?   // Минимальная ширина
  widthMax        Float?   // Максимальная ширина
  heightMin       Float?   // Минимальная высота
  heightMax       Float?   // Максимальная высота
  volumeMin       Float?   // Минимальный объём (см³)
  volumeMax       Float?   // Максимальный объём (см³)
  
  // Стоимость
  basePrice       Float    // Базовая стоимость (руб)
  pricePerKg      Float?   // Стоимость за кг (руб/кг)
  pricePerVolume  Float?   // Стоимость за объём (руб/см³)
  pricePerKm      Float?   // Стоимость за км (руб/км)
  minPrice        Float?   // Минимальная стоимость
  maxPrice        Float?   // Максимальная стоимость
  
  // Дополнительные параметры
  category        String?  // Категория товара
  isActive        Boolean  @default(true) // Активен ли тариф
  priority        Int      @default(0) // Приоритет (если несколько тарифов подходят)
  notes           String?  // Примечания
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Индексы для быстрого поиска
  @@index([marketplace, fromRegion, toRegion])
  @@index([marketplace, deliveryType])
  @@index([weightMin, weightMax])
  @@index([isActive])
  @@index([priority])
  @@index([marketplace, deliveryMethod, priceBand])
}

// Таблица категорий и комиссий маркетплейса (вознаграждение маркетплейса)
model CategoryCommission {
  id           String   @id @default(cuid())

  // Маркетплейс
  marketplace  String   @default("ozon") // ozon, wildberries, yandex-market

  // Строка матрицы комиссий Ozon (1 строка Excel = 1 запись БД)
  categoryId   String?  // Внутренний код категории, если есть
  categoryName String   // "Категория"
  productType  String?  // "Тип товара"
  categoryPath String?  // categoryName + productType (для поиска)

  // FBO
  fboUpTo100       Float?  // "FBO до 100 руб."
  fbo100To300      Float?  // "FBO свыше 100 до 300 руб."
  fbo300To500      Float?  // "FBO свыше 300 до 500 руб."
  fbo500To1500     Float?  // "FBO свыше 500 до 1500 руб."
  fboOver1500      Float?  // "FBO свыше 1500 руб."

  // FBO Fresh
  fboFreshUpTo100  Float?  // "FBO Fresh до 100 руб."
  fboFresh100To300 Float?  // "FBO Fresh свыше 100 до 300 руб."
  fboFreshOver300  Float?  // "FBO Fresh свыше 300 руб."

  // FBS / RFBS
  fbsUpTo100       Float?  // "FBS до 100 руб."
  fbs100To300      Float?  // "FBS свыше 100 до 300 руб."
  fbsOver300       Float?  // "FBS свыше 300 руб."
  rfbs             Float?  // "RFBS"

  // legacy-поля (оставлены для обратной совместимости текущего кода)
  fulfillment       String   @default("matrix")
  commissionPercent Float    @default(0)
  minCommissionAmount Float?   // Минимальная сумма комиссии (руб), если есть
  fixedFeeAmount      Float?   // Фиксированная часть комиссии (руб), если есть

  isActive    Boolean  @default(true)
  validFrom   DateTime?
  validTo     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Индексы для быстрого поиска
  @@index([marketplace, categoryName])
  @@index([marketplace, productType])
  @@index([marketplace, categoryPath])
  @@index([marketplace, categoryId])
}